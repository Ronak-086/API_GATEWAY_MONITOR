# Server
SERVER_PORT=8080

# Data stores
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/gateway?sslmode=disable

# Rate Limiter (token bucket)
RATE_LIMITER_CAPACITY=100
RATE_LIMITER_REFILL_RATE=10.0

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD_RATE=0.5
CIRCUIT_BREAKER_COOLDOWN_TIMEOUT=30s